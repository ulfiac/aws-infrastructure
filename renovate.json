{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "ulfiac"
  ],
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday updates",
      "matchPackageNames": [
        "actions/checkout",
        "hashicorp/archive",
        "hashicorp/aws",
        "aws-actions/configure-aws-credentials",
        "integrations/github",
        "gruntwork-io/terragrunt-action",
        "hashicorp/setup-terraform",
        "hashicorp/terraform",
        "hashicorp/local",
        "hashicorp/random",
        "ubuntu"
      ]
    }
  ],
  "prHourlyLimit": 10,
  "reviewers": [
    "ulfiac"
  ],
  "timezone": "America/New_York"
}
